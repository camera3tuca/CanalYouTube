# Copie para .streamlit/secrets.toml (nunca faça commit do arquivo real).
# No Streamlit Cloud, cole este conteúdo em Settings > Secrets.

PEXELS_API_KEY = "sua-chave-pexels"
PIXABAY_API_KEY = "sua-chave-pixabay"
ANTHROPIC_API_KEY = "sua-chave-anthropic"

# Publicação no YouTube (opcional) — gere o refresh token uma vez localmente.
YOUTUBE_CLIENT_ID = "xxx.apps.googleusercontent.com"
YOUTUBE_CLIENT_SECRET = "seu-client-secret"
YOUTUBE_REFRESH_TOKEN = "seu-refresh-token"
